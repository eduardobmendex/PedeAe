NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Somente migrations e testes (nunca expor no app)
DATABASE_URL=postgresql://postgres.<project-ref>:<senha-url-encoded>@aws-0-<regiao>.pooler.supabase.com:5432/postgres

# Chave secreta do Supabase (Settings → API Keys → Secret). SOMENTE no servidor:
# confirma pagamentos online (webhook) sem usuário logado.
SUPABASE_SECRET_KEY=sb_publishable_n8N4cOthu_RsBvP_lM23lw_3ShzfsGl

# Pagar.me (API v5) — painel Pagar.me → Configurações → Chaves.
# sk_test_/pk_test_ = ambiente de teste (nenhum dinheiro real); sk_/pk_ = produção.
PAGARME_SECRET_KEY=sk_test_52e32e9687ef4896b62cf41e2b9ccc8d
NEXT_PUBLIC_PAGARME_PUBLIC_KEY=pk_test_...
# Recebedor da PedeAe (para a comissão do split). Opcional se a comissão for 0%.
PAGARME_PLATFORM_RECIPIENT_ID=rp_...
# Segredo da URL do webhook: https://<domínio>/api/pagarme/webhook?token=<este valor>
PAGARME_WEBHOOK_SECRET=gere-um-valor-aleatorio-longo

# Desenvolvimento sem chaves do Pagar.me: simula Pix e cartão (nunca em produção).
# PAYMENTS_SIMULATOR=1
